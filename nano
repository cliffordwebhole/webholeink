<?php
declare(strict_types=1);

/** @var string $q */
/** @var array $results */
?>

<h1>Search</h1>

<form method="get" action="/search" style="margin-bottom: 1rem;">
    <input
        type="text"
        name="q"
        value="<?= htmlspecialchars($q ?? '', ENT_QUOTES, 'UTF-8') ?>"
        placeholder="Search posts, pages, docs…"
        style="width: 100%; max-width: 520px; padding: .6rem;"
    >
    <button type="submit" style="padding: .6rem 1rem;">Search</button>
</form>

<?php if (!empty($q)): ?>
    <p><strong><?= count($results) ?></strong> result(s) for: <code><?= htmlspecialchars($q, ENT_QUOTES, 'UTF-8') ?></code></p>
<?php endif; ?>

<?php if (empty($results) && !empty($q)): ?>
    <p>No matches found.</p>
<?php endif; ?>

<?php if (!empty($results)): ?>
    <ul>
        <?php foreach ($results as $r): ?>
            <li style="margin-bottom: 1rem;">
                <a href="<?= htmlspecialchars($r['path'], ENT_QUOTES, 'UTF-8') ?>">
                    <?= htmlspecialchars($r['title'], ENT_QUOTES, 'UTF-8') ?>
                </a>
                <small style="opacity:.7;">(<?= htmlspecialchars($r['type'], ENT_QUOTES, 'UTF-8') ?>)</small>
                <?php if (!empty($r['excerpt'])): ?>
                    <p style="margin:.25rem 0;"><?= htmlspecialchars($r['excerpt'], ENT_QUOTES, 'UTF-8') ?></p>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>
<?php endif; ?>
